root = true

# Valeurs par defaut
[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 240
end_of_line = lf

[*.conf]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.properties]
indent_size = 2

[*.sh]
indent_size = 2

[*.html]
indent_size = 2

[*.md]
max_line_length = 0
trim_trailing_whitespace = false
